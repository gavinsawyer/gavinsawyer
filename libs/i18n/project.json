{
  "$schema":     "../../node_modules/nx/schemas/project-schema.json",

  "name":        "i18n",
  "projectType": "library",
  "sourceRoot":  "libs/i18n/src",

  "targets":     {
    "angular--extract-i18n": {
      "dependsOn": [
        {
          "projects": [ "tag:app" ],
          "target":   "angular--extract-i18n"
        }
      ],
      "executor":  "nx:noop"
    },
    "build":                 {
      "dependsOn": [ "lint" ],
      "executor":  "@nx/esbuild:esbuild",
      "options":   {
        "declaration":    true,
        "esbuildOptions": {
          "banner": {
            "css": "/*!\n / Copyright © 2026 Gavin William Sawyer. All rights reserved.\n /\n",
            "js":  "/*\n * Copyright © 2026 Gavin William Sawyer. All rights reserved.\n */\n"
          }
        },
        "external":       [ "@bowstring/*" ],
        "main":           "libs/i18n/src/index.ts",
        "metafile":       true,
        "minify":         true,
        "outputPath":     "dist/libs/i18n",
        "splitting":      true,
        "treeShaking":    true,
        "tsConfig":       "libs/i18n/tsconfig.lib.json"
      },
      "outputs":   [ "{workspaceRoot}/dist/libs/i18n" ]
    },
    "extract":               {
      "dependsOn": [ "merge" ],
      "executor":  "nx:run-commands",
      "options":   { "commands": [ "rm -rf tmp/libs/i18n/extracts" ] }
    },
    "lint":                  {
      "executor": "@nx/eslint:lint",
      "options":  { "lintFilePatterns": [ "libs/i18n/src/**/*.ts" ] }
    },
    "merge":                 {
      "dependsOn": [ "angular--extract-i18n" ],
      "executor":  "nx:run-commands",
      "options":   { "commands": [ "node -p \"JSON.stringify({ locale: \\\"en-US\\\", translations: Object.assign({}, ...require(\\\"fs\\\").readdirSync(\\\"apps\\\", { withFileTypes: true }).filter((dirent) => dirent.isDirectory()).map(({ name: projectName }) => require(\\`./tmp/libs/i18n/extracts/\\${ projectName }.en-US.json\\`).translations)) }, null, 2)\" > libs/i18n/src/lib/messages/lib/en-US.json" ] }
    }
  }
}
