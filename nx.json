{
  "analytics":      true,
  "namedInputs":    {
    "default":       [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production":    [ "default" ],
    "sharedGlobals": [ ]
  },
  "nxCloudId":      "640ae4656582ba2771a1d26e",
  "parallel":       8,
  "targetDefaults": {
    "angular--browser":       { "cache": true },
    "angular--server":        { "cache": true },
    "build":                  {
      "dependsOn": [ "^build" ],
      "inputs":    [
        "production",
        "^production"
      ]
    },
    "build--cloud-functions": { "cache": true },
    "build--intl-server":     { "cache": true },
    "build--service-worker":  { "cache": true },
    "deploy":                 {
      "dependsOn": [ "^deploy" ],
      "inputs":    [
        "production",
        "^production"
      ]
    },
    "lint":                   {
      "cache":  true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.js"
      ]
    }
  }
}
